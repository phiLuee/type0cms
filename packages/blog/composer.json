{
    "name": "type0/blog",
    "description": "Blog Plugin für Laravel + Filament mit Mediathek-Integration",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Type0\\Blog\\": "src/"
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^13.0",
        "filament/filament": "^5.0",
        "type0/media": "*"
    },
    "suggest": {
        "type0/seo": "Adds SEO metadata support to blog posts, categories and tags"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Type0\\Blog\\BlogServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
