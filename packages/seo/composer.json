{
    "name": "type0/seo",
    "description": "SEO-Metadaten Modul mit OG-Image Support via type0/media",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Type0\\Seo\\": "src/"
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^13.0",
        "filament/filament": "^5.0",
        "type0/media": "*"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Type0\\Seo\\SeoServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
